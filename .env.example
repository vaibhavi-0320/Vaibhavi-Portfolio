# Copy to .env.local for local development, or add these in Vercel project settings.
# Without ANTHROPIC_API_KEY, Inkbyte runs in clearly labelled offline mode.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-opus-5-5.
INKBYTE_MODEL=

# Optional. A Telegram message to you whenever someone downloads the resume.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
